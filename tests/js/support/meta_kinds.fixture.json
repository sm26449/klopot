{
  "channels": {
    "ui": {
      "fields": []
    },
    "banner": {
      "fields": []
    },
    "telegram": {
      "fields": [
        {
          "name": "chat_id",
          "type": "string",
          "required": true,
          "secret": false,
          "default": null,
          "help": "Target chat / channel id."
        },
        {
          "name": "bot_token",
          "type": "string",
          "required": false,
          "secret": true,
          "default": null,
          "help": "Bot API token (write-only).",
          "ref_field": "bot_token_ref"
        },
        {
          "name": "parse_mode",
          "type": "select",
          "required": false,
          "secret": false,
          "default": "HTML",
          "help": "Telegram message formatting.",
          "options": [
            "HTML",
            "MarkdownV2",
            ""
          ]
        }
      ]
    },
    "sms": {
      "fields": [
        {
          "name": "phone",
          "type": "string",
          "required": true,
          "secret": false,
          "default": null,
          "help": "Destination E.164 number."
        },
        {
          "name": "gateway_url",
          "type": "string",
          "required": true,
          "secret": false,
          "default": null,
          "help": "SMS gateway base URL (http://sms-gateway:5080)."
        },
        {
          "name": "gateway_api_key",
          "type": "string",
          "required": false,
          "secret": true,
          "default": null,
          "help": "Gateway API key (write-only).",
          "ref_field": "gateway_api_key_ref"
        }
      ]
    },
    "email": {
      "fields": [
        {
          "name": "to",
          "type": "string",
          "required": true,
          "secret": false,
          "default": null,
          "help": "Recipient address(es), comma-separated."
        },
        {
          "name": "smtp_host",
          "type": "string",
          "required": true,
          "secret": false,
          "default": null,
          "help": ""
        },
        {
          "name": "smtp_port",
          "type": "int",
          "required": false,
          "secret": false,
          "default": 587,
          "help": ""
        },
        {
          "name": "username",
          "type": "string",
          "required": false,
          "secret": false,
          "default": null,
          "help": ""
        },
        {
          "name": "password",
          "type": "string",
          "required": false,
          "secret": true,
          "default": null,
          "help": "SMTP password (write-only).",
          "ref_field": "password_ref"
        },
        {
          "name": "from_addr",
          "type": "string",
          "required": false,
          "secret": false,
          "default": null,
          "help": "Envelope sender (canonical). Defaults to username if blank."
        },
        {
          "name": "use_tls",
          "type": "bool",
          "required": false,
          "secret": false,
          "default": true,
          "help": ""
        }
      ]
    },
    "push": {
      "fields": [
        {
          "name": "vapid_public",
          "type": "string",
          "required": false,
          "secret": false,
          "default": null,
          "help": ""
        },
        {
          "name": "vapid_private",
          "type": "string",
          "required": false,
          "secret": true,
          "default": null,
          "help": "VAPID private key (write-only).",
          "ref_field": "vapid_private_ref"
        },
        {
          "name": "vapid_subject",
          "type": "string",
          "required": false,
          "secret": false,
          "default": null,
          "help": "mailto: or https: contact for VAPID (required to send)."
        }
      ]
    },
    "webhook": {
      "fields": [
        {
          "name": "url",
          "type": "string",
          "required": true,
          "secret": false,
          "default": null,
          "help": "Target URL."
        },
        {
          "name": "method",
          "type": "select",
          "required": false,
          "secret": false,
          "default": "POST",
          "help": "",
          "options": [
            "POST",
            "PUT",
            "GET"
          ]
        },
        {
          "name": "content_type",
          "type": "select",
          "required": false,
          "secret": false,
          "default": "application/json",
          "help": "",
          "options": [
            "application/json",
            "application/x-www-form-urlencoded",
            "text/plain"
          ]
        },
        {
          "name": "body_template",
          "type": "text",
          "required": false,
          "secret": false,
          "default": null,
          "help": "Payload template; {title} {message} {severity} {type} placeholders. For JSON, wrap embedded text with the | jsonstr filter (e.g. {\"text\": \"{title | jsonstr}\"}). Leave blank for a default JSON body."
        },
        {
          "name": "auth_kind",
          "type": "select",
          "required": false,
          "secret": false,
          "default": "",
          "help": "How auth_value is applied.",
          "options": [
            "",
            "bearer",
            "basic",
            "header"
          ]
        },
        {
          "name": "auth_header",
          "type": "string",
          "required": false,
          "secret": false,
          "default": "Authorization",
          "help": "Header name when auth_kind=header."
        },
        {
          "name": "auth_value",
          "type": "string",
          "required": false,
          "secret": true,
          "default": null,
          "help": "Token / credential (write-only).",
          "ref_field": "auth_value_ref"
        },
        {
          "name": "expected_status",
          "type": "int",
          "required": false,
          "secret": false,
          "default": 200,
          "help": "HTTP status treated as success."
        },
        {
          "name": "timeout_sec",
          "type": "int",
          "required": false,
          "secret": false,
          "default": 10,
          "help": ""
        }
      ]
    }
  },
