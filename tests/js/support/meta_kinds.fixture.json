  "variables": {
    "mqtt": {
      "fields": [
        {
          "name": "input_id",
          "type": "int",
          "required": false,
          "secret": false,
          "default": null,
          "help": "Owning MQTT input id."
        },
        {
          "name": "topic",
          "type": "topic",
          "required": true,
          "secret": false,
          "default": null,
          "help": "MQTT topic (supports + / # wildcards)."
        },
        {
          "name": "json_path",
          "type": "string",
          "required": false,
          "secret": false,
          "default": null,
          "help": "Dot-path within a JSON payload (e.g. battery.soc)."
        },
        {
          "name": "type",
          "type": "select",
          "required": false,
          "secret": false,
          "default": "number",
          "help": "Coercion applied to the extracted value.",
          "options": [
            "number",
            "bool",
            "string",
            "json"
          ]
        },
        {
          "name": "stale_after_sec",
          "type": "int",
          "required": false,
          "secret": false,
          "default": 300,
          "help": "Value is considered stale past this age; rules gate on it."
        }
      ]
    },
    "aggregate": {
      "fields": [
        {
          "name": "topics",
          "type": "json",
          "required": true,
          "secret": false,
          "default": null,
          "help": "Member topics as a JSON array."
        },
        {
          "name": "aggregate",
          "type": "select",
          "required": false,
          "secret": false,
          "default": "sum",
          "help": "",
