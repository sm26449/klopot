        },
        {
          "name": "json_path",
          "type": "string",
          "required": false,
          "secret": false,
          "default": null,
          "help": "Dot-path within each member payload."
        },
        {
          "name": "type",
          "type": "select",
          "required": false,
          "secret": false,
          "default": "number",
          "help": "",
          "options": [
            "number",
            "bool",
            "string",
            "json"
          ]
        },
        {
          "name": "stale_after_sec",
          "type": "int",
          "required": false,
          "secret": false,
          "default": 300,
          "help": ""
        }
      ]
    },
