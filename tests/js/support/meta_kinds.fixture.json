    "sms_inbox": {
      "fields": [
        {
          "name": "auth_required",
          "type": "bool",
          "required": false,
          "secret": false,
          "default": true,
          "help": "Require X-Input-Token on the inbound POST /v1/inputs/{id}/webhook. Set False to opt out explicitly."
        },
        {
          "name": "auth_token",
          "type": "string",
          "required": false,
