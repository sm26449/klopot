.env
.env.*
!.env.example
*.pem
*.key

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Local DB / data
*.db
*.sqlite
*.sqlite3
data/
backups/

# Logs
*.log
logs/

# Alembic versions are checked in EXCEPT autogenerated stash
alembic/versions/*.pyc
backups/
shadow-reports/

# review prompts and reports (local; they quote weaknesses before they are fixed)
.audit/
# audit evidence/scripts — repro-only, not idempotent, local resources
docs/audit-artifacts/

# Node (dev-only admin-UI test tooling; shipped UI is vendored static ESM)
node_modules/
mypy-report.txt

# Site-local compose overlay (aliases, host-specific wiring) — never committed.
compose.local.yml

# Internal agent know-how (CLAUDE.md) and host facts (CLAUDE.local.md) —
# kept local, never committed or shipped in the image.
CLAUDE.md
CLAUDE.local.md

# Private, host-only material: the PV-Stack configuration exported as a pack
# and the PV-Stack specifics removed from the public code (see private/RESTORE.md).
private/

# Secrets referenced by channels / inputs / packs (KLOPOT_SECRET_*), never committed.
secrets.env
