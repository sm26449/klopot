# secrets.env — tokens and passwords Klopot's channels, inputs and packs use.
#
# Copy to secrets.env (next to .env), chmod 600, fill in, restart Klopot:
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
#   docker compose up -d alertd
#
# Every name must start with KLOPOT_SECRET_ — those are allowed as references
# automatically. In a channel / input / pack, use the NAME (e.g. a Gotify
# channel's "app_token" → "Use env ref…" → KLOPOT_SECRET_GOTIFY_TOKEN), never
# the value: the value stays in this file, out of the database and exports.

#KLOPOT_SECRET_GOTIFY_TOKEN=
#KLOPOT_SECRET_NTFY_TOKEN=
#KLOPOT_SECRET_PUSHOVER_APP_TOKEN=
#KLOPOT_SECRET_PUSHOVER_USER_KEY=
#KLOPOT_SECRET_ALERTMANAGER_TOKEN=
# Web Push (docs/WEB_PUSH.md): generate with  python scripts/vapid_keys.py
#KLOPOT_SECRET_VAPID_PRIVATE=
