      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alertd_queue_rows{job=~\"$job\",instance=~\"$instance\",state=\"pending\"}",
