    {
      "id": 7,
      "title": "Retained terminal failures",
      "description": "Inventory, not a failure rate; retained failures remain visible until retention removes their notifications.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alertd_queue_rows{job=~\"$job\",instance=~\"$instance\",state=\"failed\"}",
          "legendFormat": "{{queue}}",
