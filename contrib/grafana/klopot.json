      "id": 16,
      "title": "Fires by severity / second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity,suppressed) (rate(alertd_fires_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))",
