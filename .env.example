# Copy to .env and edit. .env is gitignored.

# ── Deployment variant ─────────────────────────────────────
# Which compose files a plain `docker compose …` uses (colon-separated).
#   production, no proxy:   docker-compose.yml           (default)
#   behind traefik:         docker-compose.yml:compose.traefik.yml
#   development:            docker-compose.yml:compose.dev.yml
#   existing MySQL server:  add :compose.external-db.yml to either production list
#   host-specific tweaks:   add :compose.local.yml (gitignored)
#COMPOSE_FILE=docker-compose.yml
#KLOPOT_PROJECT_NAME=klopot
#KLOPOT_IMAGE=ghcr.io/sm26449/klopot:latest
#KLOPOT_HTTP_PORT=5090                # host port, always bound to 127.0.0.1

# ── traefik (compose.traefik.yml only) ─────────────────────
# Public hostname, and the existing Docker network your traefik runs on.
#KLOPOT_HOSTNAME=alerts.example.com
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# Also set ALERTD_TRUSTED_PROXY_CIDRS (below) to that network's subnet.

# ── Database ───────────────────────────────────────────────
# Required — there are no default passwords; Klopot refuses to start
# without the URL. Generate each password (letters and digits, safe in a URL):
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# Bundled MySQL: put MYSQL_PASSWORD into the URL in place of <MYSQL_PASSWORD>.
# Your own server (compose.external-db.yml): only the URL is needed.
ALERTD_DATABASE_URL=mysql+aiomysql://alertd:<MYSQL_PASSWORD>@mysql:3306/alertd
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=alertd
MYSQL_USER=alertd
MYSQL_PASSWORD=
#MYSQL_INNODB_BUFFER_POOL_SIZE=256M

# ── MQTT ───────────────────────────────────────────────────
# host.docker.internal = a broker on the Docker host. A broker on a shared
# Docker network (e.g. the traefik one) is reached by its container name.
ALERTD_MQTT_HOST=host.docker.internal
ALERTD_MQTT_PORT=1883
ALERTD_MQTT_USERNAME=
ALERTD_MQTT_PASSWORD=
ALERTD_MQTT_CLIENT_ID=alertd

# ── Service ────────────────────────────────────────────────
ALERTD_LOG_LEVEL=INFO
# IANA timezone for quiet hours, hour_now() and schedules, e.g. Europe/Berlin.
ALERTD_TZ=UTC

# ── Bootstrap ──────────────────────────────────────────────
# Plaintext API key with admin scope, seeded on first run if the
# api_keys table is empty. Generate one with:
#   python -c "import secrets; print('alertd_'+secrets.token_urlsafe(32))"
# Empty = no bootstrap key (admin must use direct DB access first run).
ALERTD_BOOTSTRAP_ADMIN_KEY=

# ── Admin UI (static SPA at /admin) ─
# Serve the admin UI. On by default so the quickstart's /admin link works on a
# local install (the host port binds 127.0.0.1 only). Put it behind TLS (a
# reverse proxy) before exposing it beyond localhost. Set false to disable; the
# API is unaffected either way.
ALERTD_ADMIN_UI_ENABLED=true

# ── Admin UI login (docs/AUTH_MODEL.md "Browser sessions") ─────
# Password for the single `admin` user, used ONLY when admin_users is
# empty (first boot). Minimum 12 characters. The account is created
# with must_change_password=1 — log in, change it, then CLEAR this.
# Lost it later? docker compose exec alertd python -m scripts.admin reset-password
ALERTD_ADMIN_BOOTSTRAP_PASSWORD=
# Session cookie Secure flag. false for the plain-HTTP localhost quickstart (a
# Secure cookie is never sent over HTTP, so login would silently fail); set true
# behind TLS (compose.traefik.yml forces true). This flag also gates the API
# surface below.
ALERTD_COOKIE_SECURE=false
#ALERTD_SESSION_IDLE_HOURS=12
#ALERTD_SESSION_MAX_DAYS=7
# Login lockout: failures per username / per source IP within the window.
#ALERTD_LOGIN_MAX_FAILURES=5
#ALERTD_LOGIN_MAX_FAILURES_PER_USER=50
#ALERTD_LOGIN_MAX_FAILURES_PER_IP=20
#ALERTD_LOGIN_LOCKOUT_MIN=15
#ALERTD_AUTH_HISTORY_DAYS=30
# API surface exposure (audit S-12). Both default to "auto": with
# ALERTD_COOKIE_SECURE=true (a prod/TLS deploy) /docs, /redoc and /openapi.json
# are served only to a logged-in admin session or an X-API-Key caller, and
# /v1/metrics requires a read-scoped key; on plain-HTTP local they are open.
# Set explicitly to override (e.g. keep /docs public for an open demo).
#ALERTD_DOCS_ENABLED=true
#ALERTD_METRICS_REQUIRE_AUTH=false
# Trusted reverse-proxy CIDRs (comma-separated). Behind traefik the per-IP
# login lockout keys on the proxy unless you list the proxy network here, so the
# real client IP is read from X-Forwarded-For. Set this for any proxied deploy
# to your reverse proxy's own subnet CIDR (e.g. the Docker network it runs on).
#ALERTD_TRUSTED_PROXY_CIDRS=
# Admin-plane allowlist (comma-separated networks; empty = off): when set,
# only these clients reach anything but POST /v1/fire and the input webhooks
# — the admin UI, sign-in, health, metrics, streams. List your admins'
# networks AND the Docker network of services that call Klopot directly.
#ALERTD_ADMIN_ALLOW_CIDRS=
# Largest `context` POST /v1/fire accepts (compact JSON, bytes).
#ALERTD_FIRE_CONTEXT_MAX_BYTES=16384

# ── Secret references ──────────────────────────────────────
# `*_ref` channel/input config may only resolve env vars on this allowlist
# (comma-separated), on top of the built-ins (TELEGRAM_BOT_TOKEN, SMTP_PASSWORD,
# SMS_GATEWAY_API_KEY, ALERTD_EXTERNAL_ALARM_TOKEN, ALERTD_MQTT_USERNAME/PASSWORD).
# Extra secret names a *_ref may resolve. Usually not needed: put secrets in
# secrets.env as KLOPOT_SECRET_<NAME>=value instead (allowed automatically).
#ALERTD_SECRET_REF_ALLOW=

# Hard ceiling (seconds) on a single channel send; the backstop when an
# adapter's own HTTP timeout doesn't fire.
#ALERTD_ADAPTER_SEND_TIMEOUT_SEC=30

# ── Channel delivery secrets ───────────────────────────────
# Referenced from channels.config via *_ref indirection — the DB
# stores only the env var NAME, the value lives here. Without these
# the telegram/email/sms channels load but fail to dispatch.
TELEGRAM_BOT_TOKEN=
SMTP_PASSWORD=
SMS_GATEWAY_API_KEY=

# ── Input secrets (referenced via *_ref in inputs.config) ─────
# X-Input-Token expected by the `external_alarm` webhook input
# (inputs.config.auth_token_ref = ALERTD_EXTERNAL_ALARM_TOKEN).
# The MQTT input reuses ALERTD_MQTT_USERNAME / ALERTD_MQTT_PASSWORD
# via username_ref / password_ref — never store the broker password
# literally in inputs.config.
ALERTD_EXTERNAL_ALARM_TOKEN=

# ── Backup sidecar ─────────────────────────────────────────
# Daily mysqldump rotation (docker-compose.yml `backup` service).
BACKUP_KEEP_DAYS=30
BACKUP_CRON=0 2 * * *

# ── Tuning knobs (defaults shown; uncomment to override) ───
# See app/config.py for the full documented list.
#ALERTD_LOG_FORMAT=console            # console | json
#ALERTD_DATABASE_POOL_SIZE=10
#ALERTD_DATABASE_MAX_OVERFLOW=5
#ALERTD_MQTT_KEEPALIVE_SEC=60
#ALERTD_DEFAULT_EVAL_INTERVAL_SEC=10
#ALERTD_IDEMPOTENCY_WINDOW_SEC=300
#ALERTD_LOG_RETENTION_DAYS=90
#ALERTD_AUDIT_RETENTION_DAYS=365
#ALERTD_CIRCUIT_BREAKER_THRESHOLD=3
#ALERTD_CIRCUIT_BREAKER_OPEN_SEC=60
#ALERTD_EVAL_ERROR_DISABLE_THRESHOLD=50
#ALERTD_CORS_ORIGINS=                 # comma-separated; empty = no CORS
#ALERTD_ESCALATION_AFTER_MIN=15       # re-page unacked criticals after N min (0 = off)
#ALERTD_ESCALATION_CHANNEL=          # channel name to re-page through; empty = escalation off
#ALERTD_DIGEST_HOUR=21                # daily suppressed-alerts digest hour (local; -1 = off)
#ALERTD_SNOOZE_MORNING_HOUR=8         # "snooze until morning" button: this local hour
